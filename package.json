{
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.2",
	"engines": {
		"bun": ">=1.4.2",
		"node": ">=24.0.0"
	},
	"scripts": {
		"build": "react-router build",
		"dev": "react-router dev",
		"cf-typegen": "wrangler types",
		"postinstall": "bun run cf-typegen",
		"deploy": "react-router build && NODE_ENV=production wrangler deploy",
		"deploy:version": "react-router build && wrangler versions upload",
		"deploy:promote": "wrangler versions deploy",
		"start": "wrangler dev --test-scheduled",
		"preview": "bun run build && vite preview",
		"typecheck": "bun run cf-typegen && react-router typegen && tsc -b",
		"check": "biome check .",
		"check:fix": "biome check --fix .",
		"db:drop": "drizzle-kit drop",
		"db:generate": "drizzle-kit generate",
		"db:apply": "wrangler d1 migrations apply DB --local",
		"db:apply-prod": "wrangler d1 migrations apply DB --remote"
	},
	"dependencies": {
		"@conform-to/react": "^1.21.2",
		"@conform-to/zod": "^1.21.2",
		"@epic-web/totp": "^4.0.1",
		"@paralleldrive/cuid2": "^3.3.0",
		"@radix-ui/react-alert-dialog": "^1.2.1",
		"@radix-ui/react-avatar": "^1.3.1",
		"@radix-ui/react-checkbox": "^1.4.1",
		"@radix-ui/react-dialog": "^1.3.1",
		"@radix-ui/react-dropdown-menu": "^2.2.1",
		"@radix-ui/react-label": "^2.1.17",
		"@radix-ui/react-radio-group": "^1.5.1",
		"@radix-ui/react-slot": "^1.5.0",
		"@radix-ui/react-switch": "^1.4.1",
		"@radix-ui/react-tooltip": "^1.4.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"drizzle-orm": "~0.45.4",
		"isbot": "^5.2.2",
		"lucide-react": "^1.61.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^7.18.4",
		"remix-auth": "^4.2.0",
		"remix-auth-oauth2": "^3.4.1",
		"remix-utils": "^9.3.1",
		"sonner": "^2.0.8",
		"spin-delay": "^2.0.1",
		"tailwind-merge": "^3.7.0",
		"tailwindcss-animate": "^1.0.7",
		"ua-parser-js": "^2.0.10",
		"vaul": "^1.1.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@cloudflare/vite-plugin": "1.64.0",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@react-router/dev": "^7.18.4",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"drizzle-kit": "~0.31.11",
		"lefthook": "^2.2.2",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "8.3.5",
		"wrangler": "4.152.0"
	}
}
